## Ignore Visual Studio and Rider files

# Rider (JetBrains)
.idea/
*.iml
*.iws
out/
.idea_modules/
*.rider.solutions.xml
workspace.xml

# Rider logs
logs/
log/

# Rider plugin-related files
.rider/

# Rider caches
/.gradle/
/.gradle/
/build/
/target/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET-related files
project.lock.json
artifacts/
Generated\ Files/
*.nupkg
*.snupkg
.nuget/

# MonoDevelop/Xamarin Studio
*.userprefs
mono_crash.*

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet Packages
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Node.js (hvis du bruger det i projektet)
node_modules/

# Python cache (hvis du arbejder med Python i Rider)
__pycache__/
*.pyc

# Misc
*.tmp
*.bak
*.swp
*~

# Rider-specific exclusions
.idea/
.idea_modules/
.rider/
workspace.xml
tasks.xml
shelf/
runConfigurations/
